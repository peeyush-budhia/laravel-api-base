APP_NAME="Laravel API Base"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
APP_PORT=8080
# APP_IMAGE=ghcr.io/your-organization/laravel-api-base-app:1.0.0
# WEB_IMAGE=ghcr.io/your-organization/laravel-api-base-web:1.0.0

API_VERSION=1.0.0
SCRAMBLE_DOCS_ENABLED=false
SCRAMBLE_DEV_TOOLS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_api
DB_USERNAME=laravel_api
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-redis-password
REDIS_PORT=6379

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_ACCESS_TOKEN_EXPIRATION=120
SANCTUM_REMEMBER_ME_EXPIRATION=43200

FAILED_JOB_RETENTION_DAYS=3
AUDIT_LOG_RETENTION_DAYS=30
