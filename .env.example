# APPLICATION CONFIGURATION
APP_NAME="Laravel API Base"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# API CONFIGURATION
API_VERSION=1.0.0
SCRAMBLE_DOCS_ENABLED=true
SCRAMBLE_DEV_TOOLS=true

# LOCALE CONFIGURATION
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# MAINTENANCE CONFIGURATION
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# AUTHENTICATION CONFIGURATION
AUTH_GUARD=sanctum

# NEW PASSWORD CONFIGURATION
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_MIXED_CASE=true
AUTH_PASSWORD_REQUIRE_NUMBERS=true
AUTH_PASSWORD_REQUIRE_SYMBOLS=true

# DATABASE CONFIGURATION
# SQLite is convenient for local-only development; use MySQL for integration
# and production deployments.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_api_base
DB_USERNAME=laravel
DB_PASSWORD=

RUN_MYSQL_INTEGRATION_TESTS=false

# SESSION CONFIGURATION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# EMAIL SERVER CONFIGURATION
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SANCTUM CONFIGURATION
SANCTUM_ACCESS_TOKEN_EXPIRATION=120
SANCTUM_REMEMBER_ME_EXPIRATION=43200

# SCHEDULED DATA RETENTION CONFIGURATION
FAILED_JOB_RETENTION_DAYS=3
AUDIT_LOG_RETENTION_DAYS=30

# CACHE, QUEUE, AND BROADCAST CONFIGURATION
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PHP CONFIGURATION
# PHP_MEMORY_LIMIT=512M
PHP_CLI_SERVER_WORKERS=4

# BCRYPT CONFIGURATION
BCRYPT_ROUNDS=12

# LOGGING CONFIGURATION
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# AWS CONFIGURATION
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
