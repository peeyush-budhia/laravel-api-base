# APPLICATION CONFIGURATION
APP_NAME="Laravel API Base"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# API CONFIGURATION
API_VERSION=1.0.0
SCRAMBLE_DOCS_ENABLED=true
SCRAMBLE_DEV_TOOLS=false

# LOCALE CONFIGURATION
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# MAINTENANCE CONFIGURATION
APP_MAINTENANCE_DRIVER=file

# AUTHENTICATION CONFIGURATION
AUTH_GUARD=sanctum

# NEW PASSWORD CONFIGURATION
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_MIXED_CASE=true
AUTH_PASSWORD_REQUIRE_NUMBERS=true
AUTH_PASSWORD_REQUIRE_SYMBOLS=true

# LOGGING CONFIGURATION
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE CONFIGURATION
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_api_base_test
DB_USERNAME=laravel
DB_PASSWORD=secret

RUN_MYSQL_INTEGRATION_TESTS=false

# CACHE, QUEUE, AND BROADCAST CONFIGURATION
BROADCAST_CONNECTION=log
CACHE_STORE=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# MAIL CONFIGURATION
MAIL_MAILER=array
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SANCTUM CONFIGURATION
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_ACCESS_TOKEN_EXPIRATION=120
SANCTUM_REMEMBER_ME_EXPIRATION=43200

# SCHEDULED DATA RETENTION CONFIGURATION
FAILED_JOB_RETENTION_DAYS=3
AUDIT_LOG_RETENTION_DAYS=30

# BCRYPT CONFIGURATION
BCRYPT_ROUNDS=4
